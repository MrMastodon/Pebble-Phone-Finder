# Copy to android/keystore.properties and fill in. That file is gitignored -
# it must never be committed, and neither must the .jks itself.
#
# Generate an upload key (once, and back it up - see the root README):
#
#   keytool -genkeypair -v \
#     -keystore upload-keystore.jks \
#     -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/ directory, or may be an
# absolute path. Keeping the .jks outside the repo entirely is safest.

storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=

# CI alternative: set FMP_STORE_FILE, FMP_STORE_PASSWORD, FMP_KEY_ALIAS and
# FMP_KEY_PASSWORD as environment variables instead of using this file.
