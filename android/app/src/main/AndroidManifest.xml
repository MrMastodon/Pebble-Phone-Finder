<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_lock_silent_mode_off"
        android:label="@string/app_name"
        android:theme="@style/Theme.FindMyPhoneCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FindPhoneService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <receiver
            android:name=".StopActionReceiver"
            android:exported="false" />

        <!--
          Listener service for PebbleKitAndroid2. The official Pebble companion
          app delivers AppMessage data from our watch app (see docs/PROTOCOL.md
          for the shared UUID) to this service. Must be exported so that app can
          reach it; it does not need to be reachable by arbitrary third parties
          beyond what the library's own intent-filter/action scoping provides.
        -->
        <service
            android:name=".PebbleListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>
    </application>

</manifest>
