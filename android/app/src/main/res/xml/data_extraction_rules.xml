<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Kept in sync with backup_rules.xml; see there for rationale. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="diagnostics.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="diagnostics.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
